OPENAI_API_KEY=           # OpenAI API key for embeddings + GPT
SUPABASE_URL=             # Your Supabase project URL
SUPABASE_KEY=             # Backend-only Supabase service-role key (never expose to frontend)
CORS_ORIGINS=http://localhost:3000  # Production: exact Woodcrest frontend URL(s)
API_AUTH_TOKEN=           # Long random secret. Required in production: without it the API is public.
                          # Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
                          # Set the SAME value as CRESTMIND_API_AUTH_TOKEN on the frontend.
