# Copy to .env.local for local development. Set the same names in
# Vercel → Project → Settings → Environment Variables for production.
# None of the secrets below may use the NEXT_PUBLIC_ prefix.

# Backend URL (public). Omit to use the hosted GCP backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared sign-in password, checked on the server.
CRESTMIND_LOGIN_PASSWORD=

# Signs the session cookie. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRESTMIND_SESSION_SECRET=

# Same value as API_AUTH_TOKEN on the backend. Leave empty only if the
# backend runs without API_AUTH_TOKEN (local development).
CRESTMIND_API_AUTH_TOKEN=
